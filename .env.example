# Copy to .env and change the secrets.
DATABASE_URL=postgres://notetaker:notetaker@localhost:5432/notetaker
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN_DAYS=7
PORT=4000
# Origin of the Next.js app (used for CORS if the API is ever called directly)
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
TRUST_PROXY=1
